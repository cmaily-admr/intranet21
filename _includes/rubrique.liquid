<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ rubrique.titre }} — ADMR Côte-d'Or</title>
  <meta name="description" content="Espace {{ rubrique.titre }} des salariés de l'ADMR de Côte-d'Or.">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#5B9B31">

  <style>
    :root {
      --vert-admr:     #5B9B31;
      --vert-fonce:    #2E5A1C;
      --vert-clair:    #EAF4E0;
      --orange-admr:   #E58A00;
      --gris-texte:    #363636;
      --gris-clair:    #6B6B6B;
      --fond-page:     #F6F8F3;
      --blanc:         #FFFFFF;
      --coul-page:     {{ rubrique.couleur | default: "#2E7D9A" }};
    }
    * { box-sizing: border-box; }
    html { font-size: 112.5%; }
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; background: var(--fond-page); color: var(--gris-texte); line-height: 1.6; }
    .contenu { max-width: 900px; margin: 0 auto; padding: 0 24px; }
    .zone { padding: 46px 0; }

    .entete { background: var(--blanc); border-bottom: 3px solid var(--vert-admr); }
    .entete-inner { max-width: 1120px; margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; gap: 16px; }
    .logo-lien { display: inline-flex; align-items: center; text-decoration: none; transition: opacity .15s ease; }
    .logo-lien:hover { opacity: .85; }
    .logo-kiosque { height: 62px; width: auto; display: block; }
    @media (max-width: 640px) { .logo-kiosque { height: 50px; } }
    .logo { height: 58px; width: auto; }
    .titre-bloc { display: flex; flex-direction: column; }
    .titre-site { font-size: 1.3rem; font-weight: 800; color: var(--vert-fonce); line-height: 1.15; }
    .sous-titre-site { font-size: .88rem; color: var(--gris-clair); }
    .lien-accueil { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: var(--vert-fonce); font-weight: 700; font-size: .95rem; padding: 8px 14px; border: 1px solid #E7EBE1; border-radius: 999px; background: var(--fond-page); }
    .lien-accueil:hover { background: var(--vert-clair); }

    .hero { position: relative; overflow: hidden; background: linear-gradient(135deg, var(--vert-admr), var(--vert-fonce)); color: #fff; }
    .hero-inner { position: relative; z-index: 2; max-width: 1120px; margin: 0 auto; padding: 52px 24px; }
    .hero h1 { margin: 0 0 12px; font-size: clamp(1.8rem, 4.2vw, 2.6rem); font-weight: 800; }
    .hero p { margin: 0; font-size: 1.15rem; max-width: 680px; opacity: .96; }
    .hero .cercle { position: absolute; border-radius: 50%; z-index: 1; }
    .hero .c1 { width: 260px; height: 260px; background: rgba(255,255,255,.10); top: -80px; right: -40px; }
    .hero .c2 { width: 160px; height: 160px; background: rgba(46,125,154,.40); bottom: -60px; right: 120px; }
    .hero .c3 { width: 120px; height: 120px; background: rgba(255,255,255,.08); bottom: -30px; right: -20px; }

    .barre-recherche { margin: 0 0 24px; position: relative; }
    .barre-recherche input { width: 100%; padding: 14px 16px 14px 46px; font-size: 1rem; border: 1px solid #E7EBE1; border-radius: 12px; background: var(--blanc); color: var(--gris-texte); }
    .barre-recherche input:focus { outline: 3px solid var(--orange-admr); outline-offset: 1px; border-color: transparent; }
    .barre-recherche svg { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); width: 20px; height: 20px; color: var(--gris-clair); }
    .aucun-resultat { display: none; padding: 20px; text-align: center; color: var(--gris-clair); background: var(--blanc); border: 1px solid #E7EBE1; border-radius: 12px; }

    .faq { display: flex; flex-direction: column; gap: 14px; }
    .bloc { background: var(--blanc); border: 1px solid #E7EBE1; border-radius: 14px; overflow: hidden; }
    .bloc > summary { list-style: none; cursor: pointer; padding: 18px 22px; display: flex; align-items: center; justify-content: space-between; gap: 14px; font-weight: 800; color: var(--vert-fonce); font-size: 1.15rem; }
    .bloc > summary::-webkit-details-marker { display: none; }
    .bloc > summary::after { content: ""; width: 11px; height: 11px; border-right: 3px solid var(--coul-page); border-bottom: 3px solid var(--coul-page); transform: rotate(45deg); transition: transform .2s ease; flex: 0 0 auto; margin: 0 4px 4px 0; }
    .bloc[open] > summary::after { transform: rotate(225deg); margin: 4px 4px 0 0; }
    .bloc > summary:hover { background: var(--vert-clair); }
    .bloc > summary:focus-visible { outline: 3px solid var(--orange-admr); outline-offset: -3px; }
    .bloc-contenu { padding: 2px 22px 20px; }
    .bloc-contenu p { margin: 6px 0 14px; }

    .ligne-doc { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; padding: 14px 0; border-top: 1px solid #EEF1EA; }
    .ligne-doc:first-of-type { border-top: none; }
    .titre-doc { flex: 1 1 auto; font-weight: 600; color: var(--gris-texte); }
    .titre-doc small { display: block; font-size: .85rem; color: var(--gris-clair); font-weight: 400; }
    .doc-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; flex: 0 1 auto; }
    .btn-tel { display: inline-flex; align-items: center; gap: 8px; background: var(--vert-admr); color: #fff; text-decoration: none; padding: 9px 15px; border-radius: 9px; font-weight: 700; font-size: .9rem; }

    .btn-lien { display: inline-flex; align-items: center; gap: 8px; background: var(--vert-admr); color: #fff; text-decoration: none; padding: 10px 18px; border-radius: 9px; font-weight: 700; font-size: .95rem; margin: 6px 0; transition: background .15s ease; }
    .btn-lien:hover { background: var(--vert-fonce); }
    .liens-utiles { margin: 34px 0 0; padding: 26px 0 0; border-top: 2px solid #E7EBE1; }
    .liens-titre { font-family: var(--police-titres); margin: 0 0 16px; font-size: 1.4rem; color: var(--vert-fonce); font-weight: 800; }
    .liens-grille { display: flex; flex-wrap: wrap; gap: 12px; }
    .btn-tel:hover { background: var(--vert-fonce); }
    .btn-tel svg { width: 16px; height: 16px; }
    .btn-voir { display: inline-flex; align-items: center; gap: 8px; background: transparent; color: var(--vert-admr); border: 2px solid var(--vert-admr); text-decoration: none; padding: 7px 13px; border-radius: 9px; font-weight: 700; font-size: .9rem; }
    .btn-voir:hover { background: var(--vert-clair); }
    .btn-voir svg { width: 16px; height: 16px; }

    .image-info { max-width: 100%; max-height: 400px; width: auto; height: auto; border-radius: 12px; display: block; margin: 10px auto; border: 1px solid #E7EBE1; }
    .separateur { display: block; width: 100%; max-width: 520px; height: auto; margin: 18px auto; }
    .encadre { padding: 14px 18px; border-radius: 10px; margin: 16px 0; }
    .encadre > :first-child { margin-top: 0; }
    .encadre > :last-child { margin-bottom: 0; }
    .zoomable { cursor: zoom-in; transition: opacity .12s ease; }
    .zoomable:hover { opacity: .9; }
    .lightbox { position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,.85); display: none; align-items: center; justify-content: center; padding: 20px; }
    .lightbox.ouvert { display: flex; }
    .lightbox img { max-width: 96vw; max-height: 92vh; width: auto; height: auto; border-radius: 8px; box-shadow: 0 10px 40px rgba(0,0,0,.5); }
    .lightbox-fermer { position: absolute; top: 16px; right: 20px; width: 44px; height: 44px; border: none; border-radius: 50%; background: rgba(255,255,255,.15); color: #fff; font-size: 1.6rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .lightbox-fermer:hover { background: rgba(255,255,255,.3); }
    .video-cadre { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: 12px; overflow: hidden; margin: 10px 0; }
    .video-cadre iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

    .badge-nouveau { display: inline-block; background: var(--orange-admr); color: #fff; font-size: .68rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; padding: 3px 8px; border-radius: 999px; margin-left: 8px; vertical-align: middle; }

    .pied { background: var(--vert-fonce); color: #DDEAD3; }
    .pied-inner { max-width: 1120px; margin: 0 auto; padding: 34px 24px; display: flex; flex-wrap: wrap; gap: 26px; justify-content: space-between; }
    .pied h4 { margin: 0 0 8px; color: #fff; font-size: 1.05rem; }
    .pied a { color: #fff; }
    .pied p { margin: 4px 0; }
    .pied .mention { width: 100%; border-top: 1px solid rgba(255,255,255,.15); padding-top: 16px; font-size: .85rem; color: #BBD3AD; }

    a:focus-visible, summary:focus-visible { outline: 3px solid var(--orange-admr); outline-offset: 2px; border-radius: 6px; }
  </style>
</head>

<body>

  <header class="entete">
    <div class="entete-inner">
      <a class="logo-lien" href="/" aria-label="Le Kiosque ADMR — retour à l'accueil">
        <img class="logo-kiosque" src="/assets/logo-kiosque.svg" alt="Le Kiosque ADMR — ADMR de Côte-d'Or">
      </a>
      <a class="lien-accueil" href="/">← Accueil</a>
    </div>
  </header>

  <section class="hero">
    <span class="cercle c1"></span>
    <span class="cercle c2"></span>
    <span class="cercle c3"></span>
    <div class="hero-inner">
      <h1>{{ rubrique.titre }}</h1>
      <p>{{ rubrique.sous_titre }}</p>
    </div>
  </section>

  <section class="zone">
    <div class="contenu">

      <div class="barre-recherche">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="search" id="recherche" placeholder="Rechercher un document, une section…" aria-label="Rechercher dans cette page">
      </div>
      <p class="aucun-resultat" id="aucun-resultat">Aucun résultat pour votre recherche.</p>

      <div class="faq" id="liste-sections">
        {% for section in rubrique.sections %}
        <details class="bloc" data-section {% if section.ouvert %}open{% endif %}>
          <summary>{{ section.titre }}</summary>
          <div class="bloc-contenu">
            {% for bloc in section.blocs %}

              {% if bloc.type == "texte" %}
                <div data-doc data-recherche="{{ bloc.texte | escape }}">{{ bloc.texte | couleurs | encadres | markdown }}</div>

              {% elsif bloc.type == "document" %}
                {% assign recent = bloc.date_ajout | estRecent %}
                {% if recent or bloc.nouveau %}{% assign marque_nouveau = "nouveau" %}{% else %}{% assign marque_nouveau = "" %}{% endif %}
                <div class="ligne-doc" data-doc data-recherche="{{ bloc.titre_doc | escape }} {{ bloc.precision | escape }} {{ marque_nouveau }}">
                  <span class="titre-doc">
                    {{ bloc.titre_doc }}{% if recent or bloc.nouveau %}<span class="badge-nouveau">Nouveau</span>{% endif %}
                    {% if bloc.precision %}<small>{{ bloc.precision }}</small>{% endif %}
                  </span>
                  <div class="doc-actions">
                    <a class="btn-voir" href="/voir-pdf.html?doc={{ bloc.fichier }}">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                      Visualiser
                    </a>
                    <a class="btn-tel" href="{{ bloc.fichier }}">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v11m0 0l-4-4m4 4l4-4"/><path d="M5 19h14"/></svg>
                      Télécharger
                    </a>
                  </div>
                </div>

              {% elsif bloc.type == "image" %}
                <div data-doc data-recherche="{{ bloc.legende | escape }}">
                  <img class="image-info zoomable" src="{{ bloc.image }}" alt="{{ bloc.legende }}" onerror="this.style.display='none'">
                </div>

              {% elsif bloc.type == "video" %}
                <div data-doc data-recherche="{{ bloc.titre_video | escape }}">
                  {% if bloc.titre_video %}<p><strong>{{ bloc.titre_video }}</strong></p>{% endif %}
                  <div class="video-cadre">
                    <iframe src="{{ bloc.video_url | youtubeEmbed }}" title="{{ bloc.titre_video | default: 'Vidéo' }}" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
                  </div>
                </div>

              {% elsif bloc.type == "bouton" %}
                <div data-doc data-recherche="{{ bloc.libelle | escape }}">
                  <a class="btn-lien" href="{{ bloc.url }}" target="_blank" rel="noopener">
                    {{ bloc.libelle }}
                  </a>
                </div>

              {% elsif bloc.type == "separateur" %}
                <img class="separateur" src="/assets/separateurs/{{ bloc.modele }}" alt="" aria-hidden="true">
              {% endif %}

            {% endfor %}
          </div>
        </details>
        {% endfor %}
      </div>

      {% if rubrique.liens_utiles and rubrique.liens_utiles.size > 0 %}
      <div class="liens-utiles">
        <h2 class="liens-titre">Liens utiles</h2>
        <div class="liens-grille">
          {% for lien in rubrique.liens_utiles %}
          <a class="btn-lien" href="{{ lien.url }}" target="_blank" rel="noopener">{{ lien.libelle }}</a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

    </div>
  </section>

  <footer class="pied">
    <div class="pied-inner">
      <div>
        <h4>ADMR de Côte-d'Or</h4>
        <p>Espace réservé aux salariés</p>
      </div>
      <div>
        <h4>Un problème avec le site ?</h4>
        <p>Écrivez à : <a href="mailto:communication@admr-21.com">communication@admr-21.com</a></p>
      </div>
      <p class="mention">Ce site est un espace d'information interne. Merci de ne pas communiquer son adresse à l'extérieur.</p>
    </div>
  </footer>

  <script>
    // Recherche instantanée : filtre les documents et masque les sections vides.
    (function () {
      var champ = document.getElementById("recherche");
      if (!champ) return;
      var sections = document.querySelectorAll("[data-section]");
      var msgVide = document.getElementById("aucun-resultat");

      champ.addEventListener("input", function () {
        var q = champ.value.trim().toLowerCase();
        var totalVisible = 0;

        sections.forEach(function (section) {
          var docs = section.querySelectorAll("[data-doc]");
          var visiblesDansSection = 0;

          docs.forEach(function (doc) {
            var texte = (doc.getAttribute("data-recherche") || "").toLowerCase();
            var match = q === "" || texte.indexOf(q) !== -1;
            doc.style.display = match ? "" : "none";
            if (match) visiblesDansSection++;
          });

          if (q === "") {
            section.style.display = "";
          } else {
            section.style.display = visiblesDansSection > 0 ? "" : "none";
            if (visiblesDansSection > 0) section.setAttribute("open", "");
          }
          totalVisible += visiblesDansSection;
        });

        msgVide.style.display = (q !== "" && totalVisible === 0) ? "block" : "none";
      });
    })();
  </script>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image agrandie">
    <button class="lightbox-fermer" id="lightbox-fermer" aria-label="Fermer">&times;</button>
    <img id="lightbox-img" src="" alt="">
  </div>
  <script>
    (function () {
      var boite = document.getElementById("lightbox");
      var img = document.getElementById("lightbox-img");
      var fermer = document.getElementById("lightbox-fermer");
      if (!boite || !img) return;

      function ouvrir(src, alt) {
        img.src = src;
        img.alt = alt || "";
        boite.classList.add("ouvert");
        document.body.style.overflow = "hidden";
      }
      function fermerBoite() {
        boite.classList.remove("ouvert");
        img.src = "";
        document.body.style.overflow = "";
      }

      document.querySelectorAll(".zoomable").forEach(function (el) {
        el.addEventListener("click", function () {
          ouvrir(el.getAttribute("src"), el.getAttribute("alt"));
        });
      });

      fermer.addEventListener("click", fermerBoite);
      boite.addEventListener("click", function (e) {
        if (e.target === boite) fermerBoite(); // clic sur le fond ferme
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && boite.classList.contains("ouvert")) fermerBoite();
      });
    })();
  </script>

</body>
</html>
